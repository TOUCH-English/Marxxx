# 复制为 .env 后按需修改。不要把 .env 提交到 Git 或发给任何人。

# ---- 网页（只监听本机）----
APP_HOST=127.0.0.1
APP_PORT=8710

# ---- 实盘总开关（部署级，默认关闭；网页无法修改）----
LIVE_TRADING_ENABLED=false
# 若券商原生止损无法验证，是否接受「客户端监控止损」（电脑关机/断网时不会触发）
ALLOW_CLIENT_SIDE_STOPS_LIVE=false

# ---- moomoo OpenD（在本机运行并由您自己登录）----
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_SECURITY_FIRM=FUTUMY

# ---- AI ----
# auto：有密钥用 Claude，没有则用「固定测试响应」；也可设为 anthropic / fixture / disabled
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_S=60
AI_MONTHLY_CALL_LIMIT=3000
AI_MONTHLY_TOKEN_LIMIT=20000000
AI_MONTHLY_BUDGET_USD=30
# 每百万 token 美元价格（按 Anthropic 官方价目核对）
AI_PRICE_INPUT_PER_MTOK=4.00
AI_PRICE_OUTPUT_PER_MTOK=20.00
# 演示/历史回放是否调用真实模型（默认 false：加速回放会在几分钟内产生大量费用）
AI_IN_REPLAY=false
# 常规 AI 分析间隔（分钟），留空=60。建议 180 以控制费用；持仓大幅波动时仍会额外复核
AI_BATCH_INTERVAL_MINUTES=180
# 条件选股「20 日成交额」的换算除数（服务器值 ÷ 除数 = 日均成交额）。需在 Mac 上用日K核对后设定，见 docs/auto-universe-plan.md
SCAN_TURNOVER_DIVISOR=1

# ---- 后台 ----
WORKER_TICK_SECONDS=2
REPLAY_STEP_MINUTES=30
